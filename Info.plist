<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard bundle keys (Xcode substitutes variables at build time) -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Hemvo</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Deep-link URL scheme so hemvo:// opens the app -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.issammerhej.Hemvo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hemvo</string>
			</array>
		</dict>
	</array>

	<!-- App Store / privacy -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>

	<!-- Permissions -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Hemvo reads and writes your calendar to show household events alongside your personal schedule.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Hemvo reads and writes your calendar to show household events alongside your personal schedule.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Hemvo uses Face ID to sign you in securely.</string>

	<!-- Scene manifest (required for SwiftUI lifecycle) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Branded launch screen — HemvoGreen background matches the app's primary brand color -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>HemvoGreen</string>
	</dict>

	<!-- Supported orientations -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
