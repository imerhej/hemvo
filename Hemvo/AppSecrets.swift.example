// AppSecrets.swift.example
// Copy this file, rename to AppSecrets.swift, and fill in the real values.
// AppSecrets.swift is gitignored — never commit the filled-in version.

internal import Foundation

enum AppSecrets {
    static let supabaseURL     = "https://YOUR_PROJECT.supabase.co"
    static let supabaseAnonKey = "YOUR_SUPABASE_ANON_KEY"

    // Validated at first access; crashes immediately with a clear message if
    // supabaseURL was left as a placeholder or is otherwise malformed.
    static let supabaseBaseURL: URL = {
        guard let url = URL(string: supabaseURL), url.scheme != nil, url.host != nil else {
            fatalError(
                "[AppSecrets] supabaseURL is not a valid URL: \"\(supabaseURL)\". " +
                "Copy AppSecrets.swift.example → AppSecrets.swift and fill in your Supabase credentials."
            )
        }
        return url
    }()
}
